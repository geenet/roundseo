{
  "name": "roundseo",
  "version": "0.1.0",
  "description": "SEO inspection and tracking platform for agencies",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite",
    "dev:api": "npx wrangler dev --env development",
    "dev:setup-db": "node scripts/setup-local-sqlite.mjs",
    "dev:reset-db": "node scripts/setup-local-sqlite.mjs --fresh",
    "dev:local": "node scripts/dev-local.mjs",
    "performance:runner": "esbuild src/local/performance-runner-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/performance-runner.mjs && node dist/performance-runner.mjs",
    "build": "VITE_ROUNDSEO_BUILD_COMMIT=${VITE_ROUNDSEO_BUILD_COMMIT:-$(git rev-parse --short HEAD)} VITE_ROUNDSEO_BUILD_TIME=${VITE_ROUNDSEO_BUILD_TIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)} vite build && npm run check:build-output",
    "check:build-output": "node scripts/check-build-output.mjs",
    "check": "npm run check:ui-stack && npm run check:react-native && npm run check:ts",
    "check:ui-stack": "node scripts/check-ui-stack.mjs",
    "check:react-native": "node scripts/check-no-raw-dom.mjs",
    "check:ts": "tsc --noEmit",
    "test:unit": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:crawlers": "vitest run tests/unit/audit-rigor.test.ts tests/unit/assurance.test.ts tests/unit/real-user-page-loading.test.ts",
    "test:regression": "npm run test:unit && npm run test:e2e",
    "preview": "vite preview",
    "deploy:check": "node scripts/deployment-preflight.mjs",
    "deploy": "bash scripts/deploy.sh",
    "types:worker": "wrangler types src/worker/worker-bindings.d.ts --env development --env-interface WorkerBindings --strict-vars false",
    "eval:seo": "ROUNDSEO_WRITE_EVAL=1 vitest run tests/unit/assurance.test.ts tests/unit/audit-rigor.test.ts",
    "check:audit": "tsc --noEmit -p tsconfig.audit.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "expo-modules-core": "1.12.26",
    "expo-secure-store": "13.0.2",
    "jose": "^6.2.13",
    "nanoid": "3.3.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "^0.19.13",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241011.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.11",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.7.0",
    "playwright": "^1.47.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^4.1.11",
    "wrangler": "^3.66.0"
  }
}
