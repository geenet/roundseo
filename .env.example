# Optional: for the standalone browser runner and a remotely hosted API worker.
# Keep the same secret on the runner and Worker; never commit a real token.
ROUNDSEO_RUNNER_TOKEN=
ROUNDSEO_RUNNER_HOST=127.0.0.1
ROUNDSEO_RUNNER_PORT=8788
ROUNDSEO_PERFORMANCE_RUNNER_URL=

# RoundSEO Intelligence sources. Leave a source empty to keep its actions unavailable.
# Store secrets with `wrangler secret put <NAME>` for deployed Workers; never commit values.
# Keyword volume, CPC, competition, and monthly trends (Google Ads Keyword Plan):
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Answer-engine sampling, one key per engine:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Screenshot URL signing (falls back to JWT_SECRET when empty):
INTELLIGENCE_ASSET_SECRET=
# Ceilings for this deployment:
INTELLIGENCE_DAILY_REQUEST_LIMIT=500
INTELLIGENCE_MAX_SITE_CRAWL_PAGES=500
